{
  "name": "saavirta",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@radix-ui/react-dialog": "1.3.1",
    "@tanstack/react-query": "5.104.2",
    "@vinext/cloudflare": "1.1.0",
    "clsx": "2.1.1",
    "country-flag-icons": "1.6.20",
    "fast-xml-parser": "5.11.2",
    "maplibre-gl": "6.14.0",
    "motion": "14.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "19.3.0",
    "recharts": "3.10.1",
    "tailwind-merge": "3.7.0",
    "vinext": "1.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@cloudflare/vite-plugin": "1.63.2",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.36",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "wrangler": "4.150.0"
  },
  "type": "module",
  "overrides": {
    "fflate": "0.7.5",
    "vite-plugin-dynamic-import@1.6.0": {
      "fast-glob": "file:../../tooling/build-glob"
    }
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "start": "wrangler dev --config dist/server/wrangler.json --ip 127.0.0.1 --port 3000",
    "preview": "wrangler dev --config dist/server/wrangler.json --ip 127.0.0.1 --port 3001",
    "dev:secrets": "infisical run --env dev -- npm run dev",
    "preview:secrets": "infisical run --env dev -- npm run preview",
    "markets:demo": "npm run build && wrangler dev --config dist/server/wrangler.json --ip 127.0.0.1 --port 3000 --var MARKET_MODE:demo",
    "typecheck": "tsc --noEmit",
    "cf:types": "wrangler types --strict-vars=false",
    "lint": "eslint src tests *.ts --no-warn-ignored",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:live": "node scripts/smoke.mjs",
    "format": "prettier --write src tests scripts '*.ts' '*.js' '*.mjs' package.json wrangler.jsonc",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:runtime": "node --test tests/scripts/*.test.mjs",
    "db:local": "wrangler d1 migrations apply MARKET_DB --local"
  }
}
